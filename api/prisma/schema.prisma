generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  name     String?
  role     UserRole @default(USER)

  journeys UserJourney[]
  groups   GroupMember[]
  activities Activity[]

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  
}

model Journey {
  id          String  @id @default(uuid())
  title       String
  description String?
  icon        String?

  steps        JourneyStep[]
  participants UserJourney[]
  groups       GroupJourney[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JourneyStep {
  id        String @id @default(uuid())
  journeyId String

  title       String
  description String?

  /// Number of times required to complete the Step
  targetCount Int @default(1)

  /// Order in journey
  sortOrder Int

  journey      Journey            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userProgress UserStepProgress[]

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  groupStepProgresses GroupStepProgress[]

  @@index([journeyId])
  @@unique([journeyId, sortOrder])
}

model UserJourney {
  id        String @id @default(uuid())
  userId    String
  journeyId String

  status JourneyStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  stepProgress UserStepProgress[]

  @@unique([userId, journeyId])
  @@index([userId])
  @@index([journeyId])
}

model UserStepProgress {
  id String @id @default(uuid())

  userJourneyId String
  journeyStepId String

  currentCount Int     @default(0)
  completed    Boolean @default(false)

  completedAt DateTime?

  activity Activity[]

  userJourney UserJourney @relation(fields: [userJourneyId], references: [id], onDelete: Cascade)
  journeyStep JourneyStep @relation(fields: [journeyStepId], references: [id], onDelete: Cascade)

  @@unique([userJourneyId, journeyStepId])
  @@index([journeyStepId])
}

model Activity {
  id String @id @default(uuid())

  name String?
  note String?

  userId         String
  stepProgressId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  stepProgress UserStepProgress @relation(fields: [stepProgressId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Group {
  id          String  @id @default(uuid())
  name        String
  description String?

  members  GroupMember[]
  journeys GroupJourney[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupMember {
  id      String @id @default(uuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupJourney {
  id        String @id @default(uuid())
  groupId   String
  journeyId String

  status      JourneyStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  taskProgress GroupStepProgress[]

  @@unique([groupId, journeyId])
  @@index([groupId])
  @@index([journeyId])
}

model GroupStepProgress {
  id             String @id @default(uuid())
  groupJourneyId String
  journeyStepId  String

  currentCount Int       @default(0)
  completed    Boolean   @default(false)
  completedAt  DateTime?

  groupJourney GroupJourney @relation(fields: [groupJourneyId], references: [id], onDelete: Cascade)

  journeyStep JourneyStep @relation(fields: [journeyStepId], references: [id], onDelete: Cascade)

  @@unique([groupJourneyId, journeyStepId])
  @@index([journeyStepId])
}

enum JourneyStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum UserRole {
  ADMIN
  USER
}
