generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String    
  name      String?

  journeys  UserJourney[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Journey {
  id          String   @id @default(uuid())
  title       String
  description String?
  icon        String?

  tasks        JourneyTask[]
  participants UserJourney[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JourneyTask {
  id          String   @id @default(uuid())
  journeyId   String

  title       String
  description String?

  /// Number of times required to complete the task
  targetCount Int      @default(1)

  /// Order in journey
  sortOrder   Int

  journey      Journey            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userProgress UserTaskProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
}

model UserJourney {
  id         String   @id @default(uuid())
  userId     String
  journeyId  String

  status     JourneyStatus @default(IN_PROGRESS)

  startedAt  DateTime @default(now())
  completedAt DateTime?

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey    Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  taskProgress UserTaskProgress[]

  @@unique([userId, journeyId])
  @@index([userId])
  @@index([journeyId])
}

model UserTaskProgress {
  id             String   @id @default(uuid())

  userJourneyId  String
  journeyTaskId  String

  currentCount   Int      @default(0)

  completed      Boolean  @default(false)

  completedAt    DateTime?

  userJourney UserJourney @relation(fields: [userJourneyId], references: [id], onDelete: Cascade)
  journeyTask JourneyTask @relation(fields: [journeyTaskId], references: [id], onDelete: Cascade)

  @@unique([userJourneyId, journeyTaskId])
  @@index([journeyTaskId])
}

enum JourneyStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}
