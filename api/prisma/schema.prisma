generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String?
  role       UserRole @default(USER)

  journeyInstances JourneyInstance[]
  groups           GroupMember[]
  activities       Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Journey {
  id          String      @id @default(uuid())
  title       String
  description String?
  icon        String?
  type        JourneyType @default(INDIVIDUAL)

  steps     JourneyStep[]
  instances JourneyInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JourneyStep {
  id          String @id @default(uuid())
  journeyId   String
  title       String
  description String?
  
  /// Number of times required to complete the step
  targetCount Int    @default(1)
  /// Order of the step within the journey
  sortOrder   Int

  journey   Journey              @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  instances JourneyStepInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([journeyId, sortOrder])
  @@index([journeyId])
}

model JourneyInstance {
  id        String @id @default(uuid())
  journeyId String

  userId  String?
  groupId String?

  status      JourneyStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  stepInstances JourneyStepInstance[]

  @@unique([journeyId, userId])
  @@unique([journeyId, groupId])
  @@index([journeyId])
  @@index([userId])
  @@index([groupId])
}

model JourneyStepInstance {
  id                String @id @default(uuid())
  journeyInstanceId String
  journeyStepId     String

  currentCount Int      @default(0)
  completed    Boolean  @default(false)
  completedAt  DateTime?

  journeyInstance JourneyInstance @relation(fields: [journeyInstanceId], references: [id], onDelete: Cascade)

  journeyStep JourneyStep @relation(fields: [journeyStepId], references: [id], onDelete: Cascade)

  activities Activity[]

  @@unique([journeyInstanceId, journeyStepId])
  @@index([journeyStepId])
}

model Activity {
  id             String @id @default(uuid())
  name           String?
  note           String?
  userId         String
  stepInstanceId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  stepInstance JourneyStepInstance @relation(fields: [stepInstanceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([stepInstanceId])
}

model Group {
  id          String @id @default(uuid())
  name        String
  description String?

  members         GroupMember[]
  journeyInstances JourneyInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupMember {
  id      String @id @default(uuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

enum JourneyType {
  INDIVIDUAL
  GROUP
}

enum JourneyStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum UserRole {
  ADMIN
  USER
}